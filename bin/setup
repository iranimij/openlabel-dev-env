#!/usr/bin/env bash
# Builds the OpenLabel fixture store from scratch inside the Warden php-fpm container.
# Usage (from the host, in this directory):  warden env up -d && bin/setup
# Requires: ~/.composer/auth.json with repo.magento.com keys, admin.env (see admin.env.example), the
# Hyvä OSL packages in ./hyva (see bin/install-hyva) and the module checkouts in ./modules.
set -euo pipefail
cd "$(dirname "$0")/.."
# shellcheck disable=SC1091
source admin.env

MAGENTO_VERSION="${MAGENTO_VERSION:-2.4.9}"

run() { warden env exec -T php-fpm bash -lc "cd /var/www/html && $*"; }

if [ ! -f composer.lock ]; then
  echo "==> composer create-project magento/project-community-edition=$MAGENTO_VERSION"
  run "rm -rf /tmp/m2 && composer create-project --no-interaction --no-progress --repository-url=https://repo.magento.com/ magento/project-community-edition=$MAGENTO_VERSION /tmp/m2 && rsync -a /tmp/m2/ /var/www/html/"
fi

echo "==> setup:install"
run "bin/magento setup:install \
  --base-url=https://app.openlabel.test/ --base-url-secure=https://app.openlabel.test/ --use-secure=1 --use-secure-admin=1 \
  --backend-frontname=admin \
  --db-host=$DB_HOST --db-name=$DB_NAME --db-user=$DB_USER --db-password=$DB_PASSWORD \
  --search-engine=opensearch --opensearch-host=$OPENSEARCH_HOST --opensearch-port=9200 --opensearch-index-prefix=magento2 --opensearch-enable-auth=0 --opensearch-timeout=15 \
  --http-cache-hosts=varnish:80 \
  --session-save=redis --session-save-redis-host=redis --session-save-redis-port=6379 --session-save-redis-db=2 \
  --cache-backend=redis --cache-backend-redis-server=redis --cache-backend-redis-port=6379 --cache-backend-redis-db=0 \
  --page-cache=redis --page-cache-redis-server=redis --page-cache-redis-port=6379 --page-cache-redis-db=1 \
  --admin-user=$ADMIN_USER --admin-password=$ADMIN_PASSWORD --admin-email=$ADMIN_EMAIL --admin-firstname=Open --admin-lastname=Label \
  --language=en_US --currency=EUR --timezone=Europe/Berlin --use-rewrites=1 --cleanup-database"

echo "==> disable admin two-factor authentication (dev fixture only)"
run "bin/magento module:disable Magento_TwoFactorAuth Magento_AdminAdobeImsTwoFactorAuth"

echo "==> sample data"
run "bin/magento sampledata:deploy && bin/magento setup:upgrade"

bin/install-hyva
bin/install-modules

echo "==> store configuration: Varnish, CSP enforce on the storefront, reindex"
run "bin/magento config:set system/full_page_cache/caching_application 2"
# No secret keys in admin URLs: lets Playwright and the browser open admin pages by URL (dev fixture only).
run "bin/magento config:set admin/security/use_form_key 0"
# csp/mode/storefront/report_only has no admin field, so config:set rejects it; write it directly.
warden env exec -T db mysql -u"$DB_USER" -p"$DB_PASSWORD" "$DB_NAME" -e "INSERT INTO core_config_data (scope, scope_id, path, value) VALUES ('default',0,'csp/mode/storefront/report_only','0') ON DUPLICATE KEY UPDATE value='0'"
run "bin/magento indexer:reindex && bin/magento cache:flush"
echo "Done: https://app.openlabel.test/  admin: https://app.openlabel.test/admin"
