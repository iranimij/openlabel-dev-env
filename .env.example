# Copy to .env (warden env-init openlabel magento2 produces the same file). Values below are the ones used
# by the OpenLabel fixture store. Admin and database credentials live in admin.env (not committed).
WARDEN_ENV_NAME=openlabel
WARDEN_ENV_TYPE=magento2
WARDEN_WEB_ROOT=/

TRAEFIK_DOMAIN=openlabel.test
TRAEFIK_SUBDOMAIN=app

WARDEN_DB=1
WARDEN_ELASTICSEARCH=0
WARDEN_OPENSEARCH=1
WARDEN_ELASTICHQ=0
WARDEN_VARNISH=1
WARDEN_RABBITMQ=0
WARDEN_REDIS=1

OPENSEARCH_VERSION=2.12
MYSQL_DISTRIBUTION=mariadb
MYSQL_DISTRIBUTION_VERSION=10.6
NODE_VERSION=20
COMPOSER_VERSION=2
PHP_VERSION=8.3
PHP_XDEBUG_3=0
REDIS_VERSION=7.2
VARNISH_VERSION=7.5
